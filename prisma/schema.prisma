generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  ADMIN_FINANCIERO
  OPERACIONES
  STAFF
}
enum ClientType {
  PARTICULAR
  EMPRESA
}
enum ClientSource {
  INSTAGRAM
  FACEBOOK
  WHATSAPP
  REFERIDO
  PARTYEXPRESS
  WEB
  OTRO
}
enum Currency {
  ARS
  USD
}
enum DiscountType {
  NONE
  PERCENTAGE
  FIXED
}
enum QuoteStatus {
  CONSULTA
  PRESUPUESTO_ENVIADO
  EN_NEGOCIACION
  ESPERANDO_SENA
  CONFIRMADO
  REALIZADO
  CERRADO
  CANCELADO
}
enum QuoteItemType {
  SERVICE
  ADD_ON
  CUSTOM
}
enum EventStatus {
  CONFIRMADO
  EN_PREPARACION
  LISTO
  EN_CURSO
  REALIZADO
  CERRADO
  CANCELADO
}
enum StaffRole {
  DJ
  TECNICO
  DJ_TECNICO
}
enum AssignmentType {
  DJ
  ARMADO
  DESARMADO
  TECNICO
  DJ_TECNICO
  OTRO
}
enum PaymentType {
  ADVANCE
  PARTIAL
  FINAL
}
enum PaymentMethod {
  TRANSFER
  CASH
  OTHER
}
enum PaymentStatus {
  ACTIVE
  VOID
}
enum ExpensePaymentMethod {
  CASH
  TRANSFER
  DEBIT_CARD
  CREDIT_CARD
  MERCADO_PAGO
  OTHER
}
enum ExpenseStatus {
  ACTIVE
  VOID
}
enum ExpenseCategoryScope {
  EVENT
  GENERAL
  BOTH
}
enum FinancialAccountType {
  CASH
  BANK
  MERCADO_PAGO
  THIRD_PARTY
  OTHER
}
enum TreasuryDirection {
  INFLOW
  OUTFLOW
}
enum TreasuryCategory {
  OPENING_BALANCE
  CLIENT_PAYMENT
  STAFF_PAYMENT
  EVENT_EXPENSE
  GENERAL_EXPENSE
  REIMBURSEMENT
  TRANSFER
  INVESTMENT
  OWNER_WITHDRAWAL
  OWNER_CONTRIBUTION
  ADJUSTMENT
  OTHER
}
enum TreasuryStatus {
  ACTIVE
  VOID
}
enum ClientPaymentType {
  DEPOSIT
  PARTIAL
  BALANCE
  OTHER
}
enum ClientPaymentMethod {
  TRANSFER
  CASH
  MERCADO_PAGO
  OTHER
}
enum ReimbursementStatus {
  PENDING
  PAID
  VOID
}
enum GeneralExpenseType {
  OPERATING
  INVESTMENT
}

enum EventSource {
  SYSTEM
  EXCEL_IMPORT
}
enum FinancialStatus {
  OPEN
  READY_TO_CLOSE
  CLOSED
}

model User {
  id String @id @default(uuid()) @db.Uuid
  name String
  email String @unique
  passwordHash String
  role UserRole
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  quotesCreated Quote[] @relation("QuoteCreator")
  versionsCreated QuoteVersion[] @relation("VersionCreator")
  auditLogs AuditLog[]
  staff Staff?
  staffAssignmentsCreated EventStaff[] @relation("AssignmentCreator")
  staffPaymentsCreated StaffPayment[] @relation("PaymentCreator")
  staffPaymentsVoided StaffPayment[] @relation("PaymentVoider")
  eventExpensesCreated EventExpense[] @relation("ExpenseCreator")
  eventExpensesVoided EventExpense[] @relation("ExpenseVoider")
  financialEventsClosed Event[] @relation("FinancialCloser")
  treasuryTransactionsCreated TreasuryTransaction[] @relation("TreasuryCreator")
  treasuryTransactionsVoided TreasuryTransaction[] @relation("TreasuryVoider")
  clientPaymentsCreated ClientPayment[] @relation("ClientPaymentCreator")
  clientPaymentsVoided ClientPayment[] @relation("ClientPaymentVoider")
  openingBalancesCreated OpeningBalance[]
  transfersCreated AccountTransfer[] @relation("TransferCreator")
  transfersVoided AccountTransfer[] @relation("TransferVoider")
  reimbursementsCreated StaffReimbursement[] @relation("ReimbursementCreator")
  reimbursementsPaid StaffReimbursement[] @relation("ReimbursementPayer")
  reimbursementsVoided StaffReimbursement[] @relation("ReimbursementVoider")
  generalExpensesCreated GeneralExpense[] @relation("GeneralExpenseCreator")
  generalExpensesVoided GeneralExpense[] @relation("GeneralExpenseVoider")
  withdrawalsCreated OwnerWithdrawal[] @relation("WithdrawalCreator")
  withdrawalsVoided OwnerWithdrawal[] @relation("WithdrawalVoider")
  contributionsCreated OwnerContribution[] @relation("ContributionCreator")
  contributionsVoided OwnerContribution[] @relation("ContributionVoider")
  financialSettingsUpdated FinancialSetting[]
  excelImports ExcelImportRecord[]
}

model Session {
  id String @id @default(uuid()) @db.Uuid
  tokenHash String @unique
  userId String @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model Client {
  id String @id @default(uuid()) @db.Uuid
  name String
  type ClientType
  phone String?
  email String?
  locality String?
  address String?
  googleMapsUrl String?
  source ClientSource?
  sourceOther String?
  notes String?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  contacts ClientContact[]
  quotes Quote[]
  events Event[]
  payments ClientPayment[]
  @@index([name])
}

model ClientContact {
  id String @id @default(uuid()) @db.Uuid
  clientId String @db.Uuid
  name String
  phone String?
  email String?
  position String?
  isPrimary Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  @@index([clientId])
}

model EventType {
  id String @id @default(uuid()) @db.Uuid
  name String @unique
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  quotes Quote[]
  events Event[]
}

model Service {
  id String @id @default(uuid()) @db.Uuid
  code String? @unique
  name String
  category String
  description String?
  listPrice Decimal @db.Decimal(18,2)
  currency Currency
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items QuoteItem[]
  @@index([active, name])
}

model AddOn {
  id String @id @default(uuid()) @db.Uuid
  code String? @unique
  name String
  category String
  description String?
  listPrice Decimal @db.Decimal(18,2)
  currency Currency
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items QuoteItem[]
  @@index([active, name])
}

model TaxRate {
  id String @id @default(uuid()) @db.Uuid
  name String
  rate Decimal @db.Decimal(7,4)
  active Boolean @default(true)
  validFrom DateTime? @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DataMigration {
  id String @id @default(uuid()) @db.Uuid
  key String @unique
  appliedAt DateTime @default(now())
}

model Quote {
  id String @id @default(uuid()) @db.Uuid
  number String @unique
  clientId String @db.Uuid
  eventTypeId String @db.Uuid
  eventDate DateTime @db.Date
  guestCount Int?
  venue String
  address String?
  locality String?
  googleMapsUrl String?
  startTime String @db.VarChar(5)
  endTime String @db.VarChar(5)
  status QuoteStatus @default(CONSULTA)
  notes String?
  paymentDueDate DateTime? @db.Date
  createdById String @db.Uuid
  confirmedVersionId String? @unique @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  client Client @relation(fields: [clientId], references: [id])
  eventType EventType @relation(fields: [eventTypeId], references: [id])
  createdBy User @relation("QuoteCreator", fields: [createdById], references: [id])
  versions QuoteVersion[] @relation("QuoteVersions")
  confirmedVersion QuoteVersion? @relation("ConfirmedVersion", fields: [confirmedVersionId], references: [id])
  event Event?
  payments ClientPayment[]
  @@index([eventDate])
  @@index([status])
}

model QuoteVersion {
  id String @id @default(uuid()) @db.Uuid
  quoteId String @db.Uuid
  versionNumber Int
  currency Currency
  grossSubtotal Decimal @db.Decimal(18,2)
  itemDiscountTotal Decimal @db.Decimal(18,2)
  subtotalAfterItemDiscounts Decimal @db.Decimal(18,2)
  generalDiscountType DiscountType @default(NONE)
  generalDiscountValue Decimal @db.Decimal(18,2)
  generalDiscountAmount Decimal @db.Decimal(18,2)
  taxableBase Decimal @db.Decimal(18,2)
  taxName String?
  taxRate Decimal @db.Decimal(7,4)
  taxAmount Decimal @db.Decimal(18,2)
  totalFinal Decimal @db.Decimal(18,2)
  depositPercentage Decimal @db.Decimal(7,4)
  depositAmount Decimal @db.Decimal(18,2)
  balance Decimal @db.Decimal(18,2)
  notes String?
  createdById String @db.Uuid
  createdAt DateTime @default(now())
  quote Quote @relation("QuoteVersions", fields: [quoteId], references: [id], onDelete: Restrict)
  confirmedForQuote Quote? @relation("ConfirmedVersion")
  createdBy User @relation("VersionCreator", fields: [createdById], references: [id])
  items QuoteItem[]
  proposalOptions QuoteProposalOption[]
  sourceEvent Event? @relation("SourceVersion")
  clientPayments ClientPayment[]
  @@unique([quoteId, versionNumber])
  @@index([quoteId, createdAt])
}

model QuoteProposalOption {
  id String @id @default(uuid()) @db.Uuid
  quoteVersionId String @db.Uuid
  code String
  description String
  listPrice Decimal @db.Decimal(18,2)
  currency Currency
  sortOrder Int @default(0)
  quoteVersion QuoteVersion @relation(fields: [quoteVersionId], references: [id], onDelete: Cascade)
  @@unique([quoteVersionId, code])
  @@index([quoteVersionId, sortOrder])
}

model QuoteItem {
  id String @id @default(uuid()) @db.Uuid
  quoteVersionId String @db.Uuid
  type QuoteItemType
  serviceId String? @db.Uuid
  addOnId String? @db.Uuid
  description String
  quantity Decimal @db.Decimal(12,2)
  currency Currency
  listUnitPrice Decimal @db.Decimal(18,2)
  discountType DiscountType @default(NONE)
  discountValue Decimal @db.Decimal(18,2)
  grossAmount Decimal @db.Decimal(18,2)
  discountAmount Decimal @db.Decimal(18,2)
  finalAmount Decimal @db.Decimal(18,2)
  sortOrder Int @default(0)
  quoteVersion QuoteVersion @relation(fields: [quoteVersionId], references: [id], onDelete: Restrict)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  addOn AddOn? @relation(fields: [addOnId], references: [id], onDelete: SetNull)
  eventExpenses EventExpense[]
  @@index([quoteVersionId, sortOrder])
}

model Event {
  id String @id @default(uuid()) @db.Uuid
  number String @unique
  clientId String @db.Uuid
  eventTypeId String @db.Uuid
  source EventSource @default(SYSTEM)
  sourceQuoteId String? @unique @db.Uuid
  sourceQuoteVersionId String? @unique @db.Uuid
  eventDate DateTime @db.Date
  startTime String @db.VarChar(5)
  endTime String @db.VarChar(5)
  setupTime String? @db.VarChar(5)
  guestCount Int?
  venue String
  address String?
  locality String?
  googleMapsUrl String?
  status EventStatus @default(CONFIRMADO)
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  managerStaffId String? @db.Uuid
  financialStatus FinancialStatus @default(OPEN)
  financialClosedAt DateTime?
  financialClosedById String? @db.Uuid
  client Client @relation(fields: [clientId], references: [id])
  eventType EventType @relation(fields: [eventTypeId], references: [id])
  sourceQuote Quote? @relation(fields: [sourceQuoteId], references: [id], onDelete: Restrict)
  sourceQuoteVersion QuoteVersion? @relation("SourceVersion", fields: [sourceQuoteVersionId], references: [id], onDelete: Restrict)
  legacyFinancialData EventLegacyFinancialData?
  excelImportRecord ExcelImportRecord?
  managerStaff Staff? @relation("EventManager", fields: [managerStaffId], references: [id], onDelete: SetNull)
  financialClosedBy User? @relation("FinancialCloser", fields: [financialClosedById], references: [id], onDelete: SetNull)
  staffAssignments EventStaff[]
  staffPayments StaffPayment[]
  expenses EventExpense[]
  clientPayments ClientPayment[]
  @@index([eventDate])
  @@index([managerStaffId])
  @@index([financialStatus, eventDate])
}

model EventLegacyFinancialData {
  id String @id @default(uuid()) @db.Uuid
  eventId String @unique @db.Uuid
  saleArs Decimal? @db.Decimal(18,2)
  saleUsd Decimal? @db.Decimal(18,2)
  depositArs Decimal? @db.Decimal(18,2)
  depositUsd Decimal? @db.Decimal(18,2)
  costArs Decimal? @db.Decimal(18,2)
  costUsd Decimal? @db.Decimal(18,2)
  resultArs Decimal? @db.Decimal(18,2)
  resultUsd Decimal? @db.Decimal(18,2)
  priceFormula String?
  notes String?
  sourceSheet String
  sourceRow Int
  createdAt DateTime @default(now())
  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)
  @@index([sourceSheet, sourceRow])
}

model ExcelImportRecord {
  id String @id @default(uuid()) @db.Uuid
  fileHash String
  sheetName String
  rowNumber Int
  eventId String @unique @db.Uuid
  importedById String @db.Uuid
  importedAt DateTime @default(now())
  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)
  importedBy User @relation(fields: [importedById], references: [id], onDelete: Restrict)
  @@unique([fileHash, sheetName, rowNumber])
  @@index([fileHash, sheetName])
}

model Staff {
  id String @id @default(uuid()) @db.Uuid
  name String
  phone String?
  email String?
  defaultRole StaffRole
  defaultEventRate Decimal @default(0) @db.Decimal(18,2)
  currency Currency @default(ARS)
  active Boolean @default(true)
  userId String? @unique @db.Uuid
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  managedEvents Event[] @relation("EventManager")
  eventAssignments EventStaff[]
  payments StaffPayment[]
  expensesPaid EventExpense[]
  reimbursements StaffReimbursement[]
  generalExpensesPaid GeneralExpense[]
  withdrawals OwnerWithdrawal[]
  @@index([active, name])
}

model EventStaff {
  id String @id @default(uuid()) @db.Uuid
  eventId String @db.Uuid
  staffId String @db.Uuid
  assignmentType AssignmentType
  agreedAmount Decimal @db.Decimal(18,2)
  currency Currency
  notes String?
  createdById String @db.Uuid
  active Boolean @default(true)
  voidedAt DateTime?
  voidReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)
  staff Staff @relation(fields: [staffId], references: [id], onDelete: Restrict)
  createdBy User @relation("AssignmentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  @@unique([eventId, staffId, assignmentType])
  @@index([staffId, active])
  @@index([eventId, active])
}

model StaffPayment {
  id String @id @default(uuid()) @db.Uuid
  staffId String @db.Uuid
  eventId String? @db.Uuid
  amount Decimal @db.Decimal(18,2)
  currency Currency
  paymentDate DateTime @db.Date
  paymentMethod PaymentMethod
  paymentType PaymentType
  status PaymentStatus @default(ACTIVE)
  notes String?
  createdById String @db.Uuid
  voidedAt DateTime?
  voidedById String? @db.Uuid
  voidReason String?
  createdAt DateTime @default(now())
  accountId String? @db.Uuid
  treasuryTransactionId String? @unique @db.Uuid
  idempotencyKey String? @unique @db.Uuid
  staff Staff @relation(fields: [staffId], references: [id], onDelete: Restrict)
  event Event? @relation(fields: [eventId], references: [id], onDelete: Restrict)
  createdBy User @relation("PaymentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  voidedBy User? @relation("PaymentVoider", fields: [voidedById], references: [id], onDelete: Restrict)
  account FinancialAccount? @relation(fields: [accountId], references: [id], onDelete: Restrict)
  treasuryTransaction TreasuryTransaction? @relation("StaffPaymentTreasury", fields: [treasuryTransactionId], references: [id], onDelete: Restrict)
  @@index([staffId, paymentDate])
  @@index([eventId])
  @@index([status, currency])
  @@index([accountId])
}

model ExpenseCategory {
  id String @id @default(uuid()) @db.Uuid
  name String @unique
  slug String @unique
  active Boolean @default(true)
  sortOrder Int @default(0)
  scope ExpenseCategoryScope @default(EVENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expenses EventExpense[]
  generalExpenses GeneralExpense[]
  @@index([active, sortOrder])
}

model EventExpense {
  id String @id @default(uuid()) @db.Uuid
  eventId String @db.Uuid
  categoryId String @db.Uuid
  quoteItemId String? @db.Uuid
  description String
  amount Decimal @db.Decimal(18,2)
  currency Currency
  expenseDate DateTime @db.Date
  paidByStaffId String? @db.Uuid
  paymentMethod ExpensePaymentMethod?
  receiptUrl String?
  notes String?
  status ExpenseStatus @default(ACTIVE)
  createdById String @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  voidedAt DateTime?
  voidedById String? @db.Uuid
  voidReason String?
  accountId String? @db.Uuid
  treasuryTransactionId String? @unique @db.Uuid
  idempotencyKey String? @unique @db.Uuid
  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)
  category ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  quoteItem QuoteItem? @relation(fields: [quoteItemId], references: [id], onDelete: SetNull)
  paidByStaff Staff? @relation(fields: [paidByStaffId], references: [id], onDelete: SetNull)
  createdBy User @relation("ExpenseCreator", fields: [createdById], references: [id], onDelete: Restrict)
  voidedBy User? @relation("ExpenseVoider", fields: [voidedById], references: [id], onDelete: Restrict)
  account FinancialAccount? @relation(fields: [accountId], references: [id], onDelete: Restrict)
  treasuryTransaction TreasuryTransaction? @relation("EventExpenseTreasury", fields: [treasuryTransactionId], references: [id], onDelete: Restrict)
  reimbursement StaffReimbursement?
  @@index([eventId, status, currency])
  @@index([categoryId, expenseDate])
  @@index([paidByStaffId])
  @@index([quoteItemId])
  @@index([accountId])
}

model FinancialAccount {
  id String @id @default(uuid()) @db.Uuid
  name String
  type FinancialAccountType
  currency Currency
  active Boolean @default(true)
  includeInAvailableCash Boolean @default(true)
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  transactions TreasuryTransaction[]
  openingBalances OpeningBalance[]
  clientPayments ClientPayment[]
  staffPayments StaffPayment[]
  eventExpenses EventExpense[]
  generalExpenses GeneralExpense[]
  reimbursements StaffReimbursement[]
  transfersFrom AccountTransfer[] @relation("TransferFrom")
  transfersTo AccountTransfer[] @relation("TransferTo")
  withdrawals OwnerWithdrawal[]
  contributions OwnerContribution[]
  @@unique([name, currency])
  @@index([active, currency])
}

model TreasuryTransaction {
  id String @id @default(uuid()) @db.Uuid
  accountId String @db.Uuid
  direction TreasuryDirection
  category TreasuryCategory
  amount Decimal @db.Decimal(18,2)
  currency Currency
  transactionDate DateTime @db.Date
  description String
  referenceType String?
  referenceId String?
  status TreasuryStatus @default(ACTIVE)
  idempotencyKey String @unique @db.Uuid
  createdById String @db.Uuid
  createdAt DateTime @default(now())
  voidedAt DateTime?
  voidedById String? @db.Uuid
  voidReason String?
  account FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  createdBy User @relation("TreasuryCreator", fields: [createdById], references: [id], onDelete: Restrict)
  voidedBy User? @relation("TreasuryVoider", fields: [voidedById], references: [id], onDelete: Restrict)
  clientPayment ClientPayment? @relation("ClientPaymentTreasury")
  staffPayment StaffPayment? @relation("StaffPaymentTreasury")
  eventExpense EventExpense? @relation("EventExpenseTreasury")
  generalExpense GeneralExpense? @relation("GeneralExpenseTreasury")
  reimbursement StaffReimbursement? @relation("ReimbursementTreasury")
  openingBalance OpeningBalance?
  transferOut AccountTransfer? @relation("TransferOut")
  transferIn AccountTransfer? @relation("TransferIn")
  withdrawal OwnerWithdrawal? @relation("WithdrawalTreasury")
  contribution OwnerContribution? @relation("ContributionTreasury")
  @@index([accountId, transactionDate, status])
  @@index([referenceType, referenceId])
  @@index([category, currency, transactionDate])
}

model OpeningBalance {
  id String @id @default(uuid()) @db.Uuid
  accountId String @db.Uuid
  amount Decimal @db.Decimal(18,2)
  balanceDate DateTime @db.Date
  notes String?
  idempotencyKey String @unique @db.Uuid
  treasuryTransactionId String @unique @db.Uuid
  createdById String @db.Uuid
  createdAt DateTime @default(now())
  account FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  treasuryTransaction TreasuryTransaction @relation(fields: [treasuryTransactionId], references: [id], onDelete: Restrict)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)
  @@index([accountId, balanceDate])
}

model ClientPayment {
  id String @id @default(uuid()) @db.Uuid
  clientId String @db.Uuid
  eventId String? @db.Uuid
  quoteId String? @db.Uuid
  quoteVersionId String @db.Uuid
  accountId String? @db.Uuid
  amount Decimal @db.Decimal(18,2)
  currency Currency
  paymentDate DateTime @db.Date
  paymentMethod ClientPaymentMethod
  paymentType ClientPaymentType
  notes String?
  receivedViaPartner Boolean @default(false)
  partnerName String?
  status PaymentStatus @default(ACTIVE)
  idempotencyKey String @unique @db.Uuid
  treasuryTransactionId String? @unique @db.Uuid
  createdById String @db.Uuid
  createdAt DateTime @default(now())
  voidedAt DateTime?
  voidedById String? @db.Uuid
  voidReason String?
  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  event Event? @relation(fields: [eventId], references: [id], onDelete: Restrict)
  quote Quote? @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  quoteVersion QuoteVersion @relation(fields: [quoteVersionId], references: [id], onDelete: Restrict)
  account FinancialAccount? @relation(fields: [accountId], references: [id], onDelete: Restrict)
  treasuryTransaction TreasuryTransaction? @relation("ClientPaymentTreasury", fields: [treasuryTransactionId], references: [id], onDelete: Restrict)
  createdBy User @relation("ClientPaymentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  voidedBy User? @relation("ClientPaymentVoider", fields: [voidedById], references: [id], onDelete: Restrict)
  @@index([clientId, paymentDate])
  @@index([eventId, status])
  @@index([quoteId, status])
}

model AccountTransfer {
  id String @id @default(uuid()) @db.Uuid
  fromAccountId String @db.Uuid
  toAccountId String @db.Uuid
  amount Decimal @db.Decimal(18,2)
  currency Currency
  transferDate DateTime @db.Date
  description String
  status TreasuryStatus @default(ACTIVE)
  idempotencyKey String @unique @db.Uuid
  outTransactionId String @unique @db.Uuid
  inTransactionId String @unique @db.Uuid
  createdById String @db.Uuid
  createdAt DateTime @default(now())
  voidedAt DateTime?
  voidedById String? @db.Uuid
  voidReason String?
  fromAccount FinancialAccount @relation("TransferFrom", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount FinancialAccount @relation("TransferTo", fields: [toAccountId], references: [id], onDelete: Restrict)
  outTransaction TreasuryTransaction @relation("TransferOut", fields: [outTransactionId], references: [id], onDelete: Restrict)
  inTransaction TreasuryTransaction @relation("TransferIn", fields: [inTransactionId], references: [id], onDelete: Restrict)
  createdBy User @relation("TransferCreator", fields: [createdById], references: [id], onDelete: Restrict)
  voidedBy User? @relation("TransferVoider", fields: [voidedById], references: [id], onDelete: Restrict)
  @@index([transferDate, currency])
}

model StaffReimbursement {
  id String @id @default(uuid()) @db.Uuid
  staffId String @db.Uuid
  eventExpenseId String? @unique @db.Uuid
  generalExpenseId String? @unique @db.Uuid
  amount Decimal @db.Decimal(18,2)
  currency Currency
  status ReimbursementStatus @default(PENDING)
  paidAt DateTime? @db.Date
