{
  "name": "murray-djs",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "RUN_DB_INTEGRATION=true vitest run tests/integration",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "e2e:prepare": "tsx scripts/ensure-e2e-db.ts && prisma migrate reset --force",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "db:local": "tsx scripts/dev-postgres.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.14.0",
    "argon2": "^0.44.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "decimal.js": "^10.6.0",
    "jose": "^6.0.12",
    "lucide-react": "^0.539.0",
    "next": "^15.4.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.54.2",
    "@tailwindcss/postcss": "^4.1.11",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.17.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9.33.0",
    "eslint-config-next": "^15.4.6",
    "jsdom": "^26.1.0",
    "prisma": "^6.14.0",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "packageManager": "pnpm@10.14.0"
}
